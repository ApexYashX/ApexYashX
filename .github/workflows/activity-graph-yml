name: Activity Graph

on:
  push:
    branches:
      - main

  schedule:
    - cron: "0 0 * * *"

  workflow_dispatch:

permissions:
  contents: write

jobs:
  update:
    runs-on: ubuntu-latest

    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Download Activity Graph
        run: |
          curl -fL --retry 3 \
            "https://github-readme-activity-graph-pq1l.vercel.app/graph?username=ApexYashX" \
            -o activity-graph.svg

      - name: Check SVG
        run: |
          head -c 200 activity-graph.svg
          echo

      - name: Commit Graph
        run: |
          git config user.name "github-actions[bot]"
          git config user.email "41898282+github-actions[bot]@users.noreply.github.com"
          git add activity-graph.svg
          git diff --cached --quiet || git commit -m "Update activity graph"
          git push
